APP_NAME="АКВТ"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://akvt.ru

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU
APP_TIMEZONE=Europe/Astrakhan

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=sqlite
# На продакшн-сервере (Astra Linux / РЕД ОС / Ubuntu):
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=akvt_db
# DB_USERNAME=akvt_user
# DB_PASSWORD=your_secure_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="info@akvt.ru"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================================================
# АДМИНИСТРАТИВНЫЕ ДАННЫЕ И РЕКВИЗИТЫ АКВТ (ИЗ ТЗ)
# ==============================================================================
