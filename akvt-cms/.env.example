COLLEGE_OFFICIAL_NAME="ГБПОУ АО «Астраханский колледж вычислительной техники»"
COLLEGE_SHORT_NAME="АКВТ"
COLLEGE_SLOGAN="Территория успеха"
COLLEGE_PHONE_RECEPTION="+7 (8512) 66-75-03"
COLLEGE_PHONE_HOTLINE="+7 (8512) 99-99-54"
COLLEGE_EMAIL="info@akvt.ru"
COLLEGE_ADDRESS="414056, г. Астрахань, пер. Смоляной, д. 2"
